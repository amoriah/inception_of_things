TEAM_LOGIN = "amoriah"
DEBIAN_BOX = "bento/debian-13"

Vagrant.configure("2") do |config|
  config.vm.box = DEBIAN_BOX

  config.vm.define "#{TEAM_LOGIN}P3" do |node|
    node.vm.hostname = "#{TEAM_LOGIN}P3"

    # Отдельный адрес, чтобы не конфликтовать с p1 (.110/.111) и p2 (.110)
    node.vm.network "private_network", ip: "192.168.56.120"

    node.vm.provider "virtualbox" do |vb|
      vb.name = "#{TEAM_LOGIN}P3"
      vb.cpus = 2
      vb.memory = 4096
    end

    # Инструменты и кластер на защите запускаем вручную (см. README):
    #   vagrant ssh -c "bash /vagrant/scripts/install-tools.sh"
    #   vagrant ssh -c "bash /vagrant/scripts/bootstrap.sh"
  end
end

